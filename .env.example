# Copy to .env and fill in. Never commit .env.

# Host port the app is served on (http://<server-ip>:APP_PORT)
APP_PORT=80

# Supabase (Session pooler)
SUPABASE_DB_URL=jdbc:postgresql://aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.skbzngzwvfhkyxdpeckd
SUPABASE_DB_PASSWORD=

# Third-party APIs
MAPTILER_API_KEY=
CLIMATIQ_API_KEY=
OPENAI_API_KEY=

# Max DB connections per backend instance (Supabase session pooler allows 15 total)
DB_POOL_SIZE=3

# Secret that signs login tokens. Generate one with: openssl rand -base64 32
# Leave empty and every backend restart logs all users out.
AUTH_TOKEN_SECRET=

# Browser origins allowed to call the API (comma-separated, wildcards ok).
# Add your public URL here if it isn't on Tailscale Funnel.
# CORS_ALLOWED_ORIGINS=http://localhost:*,https://*.tail3e22ba.ts.net
